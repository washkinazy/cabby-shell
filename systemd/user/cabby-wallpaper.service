[Unit]
Description=Cabby wallpaper
BindsTo=niri.service cabby-session.service
After=niri.service cabby-session.service
PartOf=cabby.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/cabby wallpaper --config %t/cabby-shell/active.toml
UMask=0077
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
RestartSec=1
